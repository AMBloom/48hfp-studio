    console.print(Panel(content, title=f"[bold]{title}[/bold]", border_style=border_style))


def display_profile_table(
    team_name: str,
    admin_username: str,
    location: str,
    roles: Dict[str, List[str]],
    custom_details: Optional[str] = None,
    updated_at: Optional[str] = None,
) -> None:
