        )

    print_panel(
        content=f"[bold white]Status Overview[/bold white]\n\n"
        f"Version: [cyan]{__version__}[/cyan]\n\n"
        f"Global Profile:\n{profile_info}\n\n"
        f"Friday Night Kickoff Draw:\n{draw_info}\n",
